[Unit]
Description=OpenRD RK3588 drive control agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linaro
Group=linaro
WorkingDirectory=/home/linaro/OpenRD/vehicle/control_agent
Environment=OPENRD_DRIVE_AGENT_CLOUD_URL=http://43.139.25.165:8790
Environment=OPENRD_DRIVE_AGENT_VEHICLE_ID=openrd-001
Environment=OPENRD_DRIVE_AGENT_DRIVER_URL=http://192.168.100.114
EnvironmentFile=-/home/linaro/OpenRD/vehicle/control_agent/run/openrd-control-agent.env
ExecStart=/usr/bin/python3 /home/linaro/OpenRD/vehicle/control_agent/openrd-control-agent
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
