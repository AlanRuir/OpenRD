[Unit]
Description=OpenRD public control service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/OpenRD/server/openrd_control_service
Environment=OPENRD_CONTROL_HOST=0.0.0.0
Environment=OPENRD_CONTROL_PORT=8790
Environment=OPENRD_CONTROL_ALLOW_ORIGIN=*
Environment=OPENRD_CONTROL_AGENT_TIMEOUT_SEC=45
Environment=OPENRD_CONTROL_VIDEO_MODE=whip
Environment=OPENRD_CONTROL_WHIP_URL=http://43.139.25.165:8888/index/api/webrtc?app=live&stream=openrd&type=push
Environment=OPENRD_CONTROL_WHEP_URL=http://43.139.25.165:8888/index/api/webrtc?app=live&stream=openrd&type=play
Environment=OPENRD_VIDEO_LATENCY_STATUS_FILE=/tmp/openrd-video-latency.json
EnvironmentFile=-/home/ubuntu/OpenRD/server/openrd_control_service/run/openrd-control.env
ExecStart=/usr/bin/python3 /home/ubuntu/OpenRD/server/openrd_control_service/openrd_control_service.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
